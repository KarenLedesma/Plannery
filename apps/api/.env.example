# Copiar a apps/api/.env y completar. Nunca subir el .env real.
DATABASE_URL=postgresql://usuario:clave@host:5432/plannery
JWT_SECRET=
FRONTEND_URL=http://localhost:5173
PORT=3000
NODE_ENV=development
# Servicio de IA: la clave va solo en el backend, nunca en el frontend
AI_API_KEY=
# Solo para el seed (usuarios de prueba)
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
